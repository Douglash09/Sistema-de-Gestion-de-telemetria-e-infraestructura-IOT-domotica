{
  "name": "domotix-iot-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "lint": "node --check src/server.js src/simulator.js tests/api.test.js",
    "simulate": "node --env-file-if-exists=.env src/simulator.js"
  }
}
